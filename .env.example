# In ".env" umbenennen und ausfüllen

# --- E-Mail-Versand (SMTP) ---
# Gmail: smtp.gmail.com, Port 465, App-Passwort nötig (Google-Konto > Sicherheit > App-Passwörter)
# Posteo: posteo.de, Port 465, normales Posteo-Passwort
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=junesyamm@googlemail.com
SMTP_PASS=hier-app-passwort
MAIL_FROM=Bahn-Angebote <junesyamm@googlemail.com>
EMPFAENGER=junesyamm@googlemail.com,schwoerer@posteo.de

# --- Suche ---
TAGE_VORAUS=60
MIN_PREIS=0
MAX_PREIS=30
PAUSE_MS=1500

# --- API (optional) ---
PORT=3000
API_TOKEN=
CHECK_INTERVALL_MIN=0
